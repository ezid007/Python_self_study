    "import datetime\n",
    "\n",
    "now = datetime.datetime.now()\n",
    "weekday_list = [\"월요일\", \"화요일\", \"수요일\", \"목요일\", \"금요일\", \"토요일\", \"일요일\"]\n",
    "weekday_list[now.weekday()]\n",
    "\n",
    "date_of_birth = datetime.datetime(year=1995, month=12, day=15, hour=4)\n",
    "print(date_of_birth)\n"
   ]
